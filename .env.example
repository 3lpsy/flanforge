# Copy to .env and edit for the Mac that builds the retained Tart template.
# build-template.sh sources this as trusted shell syntax.

# Empty leaves dependency-proxy routing to each workflow.
# Custom, used for chilled-proxy and custom registries
# SERVICES_ROOT_DOMAIN=""

# Required unless the runner binary is passed as the sole command argument.
# FLANFORGE_RUNNER_BINARY_FILE="${HOME}/Downloads/forgejo-runner-12.13.1-darwin-arm64"

# Empty creates or reuses the expected FlanForge identity at:
# ~/Library/Application Support/flanforge/guest-ssh-key{,.pub}
# FLANFORGE_GUEST_SSH_PUBLIC_KEY_FILE=""

# Move the selected Simulator's first-start work into template creation.
FLANFORGE_PREWARM_ENABLED="true"
FLANFORGE_PREWARM_TARGET="iPhone 17 Pro"

# Optional: host that test-template.sh checks on 443 and 22 from inside a
# clone, proving the guest's tailnet policy reaches the forge.
# FLANFORGE_TEST_GIT_HOST="git.example.com"

# Optional retained Headscale/Tailscale login. Disabled by default. Enabling
# this intentionally makes every clone share the template's node identity.
# FLANFORGE_TAILSCALE_ENABLED="false"
# FLANFORGE_TAILSCALE_PREAUTH_KEY="hskey-auth-prefix-secret"
# FLANFORGE_TAILSCALE_LOGIN_SERVER="https://headscale.example.com"
# FLANFORGE_TAILSCALE_HOSTNAME="flanforge-ci"
# A single argument string, split without invoking a shell.
# FLANFORGE_TAILSCALE_EXTRA_ARGS="--accept-dns=true --shields-up"

# Required by default so the retained image does not keep the public base
# image's known administrator password.
# FLANFORGE_ADMIN_PASSWORD="replace-with-at-least-16-visible-characters"
DISABLE_ADMIN_PASSWORD_CHANGE="false"

TART_BASE_IMAGE="ghcr.io/cirruslabs/macos-tahoe-xcode:latest"
TART_VM_NAME="flanforge-base"
TART_VM_CPU="8"
TART_VM_MEMORY_GB="12"
TART_VM_DISK_GB="0"
# TART_HOME="${HOME}/.tart"

# Packer and the Tart plugin can need substantial temporary storage.
PACKER_TMP_DIR="${TART_HOME:-${HOME}/.tart}/packer-tmp"
PACKER_CACHE_DIR="${TART_HOME:-${HOME}/.tart}/packer-cache"

RUST_TOOLCHAIN="stable"
JUST_VERSION="1.57.0"
NEXTEST_VERSION="0.9.140"
SCCACHE_VERSION="0.17.0"
