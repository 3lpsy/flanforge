# Agent worktrees: a full checkout each, never part of the tree.
.claude/worktrees/

# Built web UI bundle; produced by 'just ui-build', embedded at daemon build time.
# The directory itself is committed (.gitkeep): include_dir! needs it to exist
# even when cargo skips the build script that would create it.
/webui/dist/*
!/webui/dist/.gitkeep
