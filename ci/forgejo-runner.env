# Source pin for the unsupported Darwin/ARM64 Forgejo Runner cross-build.
# build-runner.yml publishes forgejo-runner-v<VERSION>; release.yml downloads
# that exact release and verifies its checksum before bundling it.
FORGEJO_RUNNER_VERSION=12.13.1
FORGEJO_RUNNER_COMMIT=028abfe75988fde4f1019301035d2b3ccc096c89
