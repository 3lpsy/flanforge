[Unit]
Description=Restore the FlanForge Tailscale operator
Documentation=https://tailscale.com/docs/reference/troubleshooting/linux/linux-operator-permission
Requires=tailscaled.service
After=tailscaled.service
Before=sshd.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/tailscale set --operator=runner
RemainAfterExit=yes
TimeoutStartSec=30s
UMask=0077
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
