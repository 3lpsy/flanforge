# Copy to .env beside this file. build.sh and test.sh source it as trusted shell.

# Fedora Cloud 44 x86-64, constrained by the published SHA-256.
LIBVIRT_BASE_IMAGE_URL="https://download.fedoraproject.org/pub/fedora/linux/releases/44/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-44-1.7.x86_64.qcow2"
LIBVIRT_BASE_IMAGE_SHA256="28680fe5b371a5a82ebf43a31926e086a168e59949d03969c5093e7071f90b7f"

LIBVIRT_IMAGE_NAME="flanforge-base"
LIBVIRT_OUTPUT_DIR="${template_dir}/output"
LIBVIRT_BUILD_CPU="4"
LIBVIRT_BUILD_MEMORY_MB="4096"
LIBVIRT_DISK_SIZE_MB="40960"
PACKER_CACHE_DIR="${HOME}/.cache/packer"

# Optional Cargo, npm/Bun, Python/PyTorch, Maven/Gradle routes and Docker mirror.
# SERVICES_ROOT_DOMAIN="example.com"
# FLANFORGE_CONTAINER_REGISTRY_MIRROR="registry.example.com/dockerhub"
# FLANFORGE_DEPENDENCY_CA_FILE="/absolute/path/to/private-ca.pem"

# The latest Forgejo Runner is resolved at build time. These are upstream
# endpoints and the release signing key, not a runner version pin.
FORGEJO_RUNNER_API_URL="https://data.forgejo.org/api/v1/repos/forgejo/runner/releases/latest"
FORGEJO_RUNNER_DOWNLOAD_BASE_URL="https://code.forgejo.org/forgejo/runner/releases/download"
FORGEJO_RELEASE_KEY_FINGERPRINT="EB114F5E6C0DC2BCDD183550A4B61A2DC5923710"

# The privileged automation account (prunner, uid 2001) the daemon drives for
# root-needing guest work such as the warm strip. Locked password and
# passwordless sudo by default; a password swaps the rule to password-gated
# sudo for operators (the daemon's automated strip needs the default).
# FLANFORGE_PRIVILEGED_ACCOUNT="true"
# FLANFORGE_PRIVILEGED_SUDO_PASSWORD=""

# Optional retained Tailscale/Headscale login, enabled only by supplying a
# pre-auth key. The key is uploaded through a private file and deleted in the
# guest, but the resulting node identity stays in the image, so every clone
# shares it. The daemon's own [tailscale] block joins each allocation instead.
# FLANFORGE_TAILSCALE_PREAUTH_KEY="tskey-auth-prefix-secret"
# FLANFORGE_TAILSCALE_LOGIN_SERVER="https://headscale.example.com"
# FLANFORGE_TAILSCALE_HOSTNAME="flanforge-linux-ci"
# A single argument string, split without invoking a shell.
# FLANFORGE_TAILSCALE_EXTRA_ARGS="--accept-dns=true --shields-up"

# Destructive clone tests require dedicated, pre-provisioned test resources.
# Both names must begin with flanforge-test.
# FLANFORGE_LIBVIRT_TEST_POOL="flanforge-test"
# FLANFORGE_LIBVIRT_TEST_NETWORK="flanforge-test"
LIBVIRT_TEST_CPU="2"
LIBVIRT_TEST_MEMORY_MB="4096"
# The built-in default is this tag pinned by digest; setting it here
# without the digest would silently drop that pin.
# LIBVIRT_TEST_CONTAINER_IMAGE="docker.io/library/alpine:3.22"
# Per-RPC, bulk-transfer, connected-SSH, readiness-deadline, and probe bounds.
LIBVIRT_TEST_RPC_TIMEOUT_SECONDS="30"
LIBVIRT_TEST_TRANSFER_TIMEOUT_SECONDS="1800"
LIBVIRT_TEST_SSH_TIMEOUT_SECONDS="300"
LIBVIRT_TEST_READINESS_TIMEOUT_SECONDS="120"
LIBVIRT_TEST_READINESS_PROBE_TIMEOUT_SECONDS="10"
# FLANFORGE_LIBVIRT_TEST_CONFIRM="destroy-test-resources"
